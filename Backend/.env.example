# =============================================================
# Brush Backend — Environment Configuration
# =============================================================
# Copy this file to .env and fill in your values.
# Never commit the actual .env file to version control.
# =============================================================

# ── Server ──────────────────────────────────────────────────
PORT=5500
SITE_URL=https://immortal0p.github.io/Brush-Production

# ── MongoDB Atlas ───────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── Razorpay ────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ── Firebase (image storage) ───────────────────────────────
# Place your serviceAccountKey.json in the Backend/ directory.
# The file path is hardcoded in server.js as ./serviceAccountKey.json
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# ── Email (Nodemailer / SMTP) ──────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="Brush Posters" <noreply@brushposters.com>

# ── Admin Setup (used by setupAdmin.js) ────────────────────
SETUP_ADMIN_USERNAME=admin
SETUP_ADMIN_PASSWORD=change-me-immediately
